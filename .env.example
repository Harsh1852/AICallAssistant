# ── Twilio ────────────────────────────────────────────────────────────────────
# Twilio Console → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15550000000          # Your Twilio number, E.164 format

# ── LLM provider (Groq is used when both are set) ─────────────────────────────
# Groq has a free tier and is OpenAI-API-compatible, so either key works.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=

# Optional — override the model. Defaults to openai/gpt-oss-20b on Groq,
# gpt-4o on OpenAI.
# LLM_MODEL=

# ── Who the assistant answers for ─────────────────────────────────────────────
MY_NAME=user's name

# Your real phone. Twilio rings this first, so you get a chance to pick up
# before the AI answers. Leave blank to have the AI answer immediately.
OWNER_PERSONAL_NUMBER=+15550000001

# Where a caller is transferred when they press 0, and where call-notification
# texts are sent. A separate number (e.g. Google Voice) is recommended so the
# transfer doesn't collide with OWNER_PERSONAL_NUMBER.
OWNER_PHONE_NUMBER=+15550000002

# Seconds to ring OWNER_PERSONAL_NUMBER before the AI takes over. Default 10.
# OWNER_RING_TIMEOUT_SECONDS=10

# ── What the assistant knows ──────────────────────────────────────────────────
# This is the entire context the AI has about you. It is injected into the
# system prompt, so treat it as public: anything here can be spoken to a
# caller. Say what the assistant should collect, and what it must not reveal.
MY_INFO=Context

# ── App URL ───────────────────────────────────────────────────────────────────
# The public HTTPS URL of this deployment. Twilio calls back to it, and it is
# used to verify webhook signatures — it must match exactly, no trailing slash.
BASE_URL=https://your-app.onrender.com

# ── Dashboard access ──────────────────────────────────────────────────────────
# The dashboard shows caller numbers and full transcripts, and can transfer a
# live call. It is disabled until both of these are set. Use a long password.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change_me_to_something_long_and_random

# ── Google Sheets logging (optional) ──────────────────────────────────────────
# Without these, calls still work but nothing is logged and the dashboard's
# history and blocklist features are unavailable.
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Service account key. Use a file path for local dev, or paste the JSON as a
# single line when your host only supports env vars.
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ── Google Calendar booking (optional) ────────────────────────────────────────
# Lets the AI check availability and book appointments.
#
# Recommended: create a dedicated secondary calendar (e.g. "AI Bookings") and
# share ONLY that one with the service account email from
# GOOGLE_CREDENTIALS_JSON, granting "Make changes to events". This is the only
# calendar the AI can write to.
GOOGLE_CALENDAR_ID=xxxx@group.calendar.google.com

# Optional — lets the AI also see conflicts on your real calendar when checking
# availability (it still only ever books onto GOOGLE_CALENDAR_ID above). Share
# it with the service account at the "See only free/busy" permission level,
# which reveals busy blocks without exposing event titles or details.
GOOGLE_MAIN_CALENDAR_ID=

# IANA timezone name. All appointment times are interpreted in this zone.
TIMEZONE=America/Los_Angeles

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Local development only ────────────────────────────────────────────────────
# Disables Twilio request-signature verification. Only useful when replaying
# webhooks by hand with curl. NEVER set this in a real deployment: it makes
# every voice endpoint callable by anyone who knows the URL.
# SKIP_WEBHOOK_VALIDATION=true

# Override the URL used to verify signatures, if your host sits behind an extra
# proxy or CDN and the reconstructed URL doesn't match what Twilio signed.
# PUBLIC_URL_OVERRIDE=
